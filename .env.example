# Copy this file to .env and set local secrets there.
# Never commit .env or put real secrets in this example.

# PostgreSQL service
POLARIS_POSTGRES_USER=polaris
POLARIS_POSTGRES_PASSWORD=
POLARIS_POSTGRES_DB=polaris
POLARIS_POSTGRES_PORT=5432

# Canonical application/runtime and Alembic migration target.
# Example: postgresql+asyncpg://polaris:<password>@127.0.0.1:5432/polaris
POLARIS_DATABASE_URL=

# PostgreSQL integration-test target. Tests create and remove their own
# disposable schema, so a separate physical database is not required.
POLARIS_TEST_DATABASE_URL=

# Optional application/migration schema override. Leave unset to use the
# connection's default PostgreSQL search path.
# POLARIS_DATABASE_SCHEMA=polaris
