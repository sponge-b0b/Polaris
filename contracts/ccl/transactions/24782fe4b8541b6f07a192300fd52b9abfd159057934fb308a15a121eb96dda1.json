  "revisions": [
    {
      "assertions": [
        {
          "assertion_id": "context.assembly",
          "authority": {
            "source_ids": [
              "decision-350-resolution",
              "adr-0006"
            ]
          },
          "constraint": {
            "expression": "Decision Context is an assembled, time-specific historical view over canonical domain facts, not a separately authoritative persisted aggregate. The same underlying fact may participate in Decision Context and an Evidence role without becoming two facts. Historical reconstruction distinguishes what applied from what information was available to the particular judgment.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "decision_context"
        },
        {
          "assertion_id": "observation.material-persistence",
          "authority": {
            "source_ids": [
              "decision-350-resolution",
              "adr-0006",
              "adr-0012"
            ]
          },
          "constraint": {
            "expression": "Material Evidence observations are durable first-class facts with opaque identity, attributable source provenance/authority, subject/reference identity, temporal provenance, and reconstructable retained representation/reference. Later information cannot become retroactively available to an earlier judgment.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "evidence_observation"
        },
        {
          "assertion_id": "binding.material-persistence",
          "authority": {
            "source_ids": [
              "decision-350-resolution",
              "adr-0006",
              "adr-0012"
            ]
          },
          "constraint": {
            "expression": "Judgment-relative Evidence bindings durably preserve material Judgment-Time Availability, actual use, Evidence role, Freshness Requirement basis/result, and material qualifications. Evidence fitness is use-specific and distinct from availability, sufficiency, relevance, materiality, and authority.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "evidence_binding"
        },
        {
          "assertion_id": "availability.vocabulary",
          "authority": {
            "source_ids": [
              "decision-350-resolution",
              "adr-0006"
            ]
          },
          "constraint": {
            "closure": "closed",
            "members": [
              "AVAILABLE",
              "UNKNOWN",
              "UNAVAILABLE"
            ],
            "name": "judgment_time_availability"
          },
          "kind": "vocabulary",
          "subject": "evidence_binding"
        },
        {
          "assertion_id": "freshness.vocabulary",
          "authority": {
            "source_ids": [
              "decision-350-resolution",
              "adr-0006"
            ]
          },
          "constraint": {
            "closure": "closed",
            "members": [
              "FRESH",
              "INDETERMINATE",
              "STALE"
            ],
            "name": "historical_freshness"
          },
          "kind": "vocabulary",
          "subject": "evidence_binding"
        },
        {
          "assertion_id": "sufficiency.vocabulary",
          "authority": {
            "source_ids": [
              "decision-350-resolution",
              "adr-0006",
              "decision-364-final-resolution",
              "adr-0013"
            ]
          },
          "constraint": {
            "closure": "closed",
            "members": [
              "INDETERMINATE",
              "INSUFFICIENT",
              "SUFFICIENT"
            ],
            "name": "sufficiency"
          },
          "kind": "vocabulary",
          "subject": "evidence_assessment"
        },
        {
          "assertion_id": "correction.history",
          "authority": {
            "source_ids": [
              "decision-350-resolution",
              "adr-0006",
              "decision-364-final-resolution",
              "adr-0012"
            ]
          },
          "constraint": {
            "mode": "append-only"
          },
          "kind": "history",
          "subject": "evidence_observation_correction"
        },
        {
          "assertion_id": "claim.catalog",
          "authority": {
            "source_ids": [
              "decision-364-final-resolution",
              "adr-0012",
              "adr-0013"
            ]
          },
          "constraint": {
            "expression": "Each admitted EvidenceJudgmentRef family may expose zero or more explicitly declared material claims. A target declares a separate claim whenever Evidence role, availability, freshness, sufficiency, or contestation can differ for that proposition; judgment-wide scope is valid only when the relation truly applies to the whole target. Claim identity is the typed pair (EvidenceJudgmentRef, ClaimId); claims are target-owned, catalogs are complete/versioned, and narrative text is never inferred into claims.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "evidence_judgment_target"
        },
        {
          "assertion_id": "requirement.authority",
          "authority": {
            "source_ids": [
              "decision-364-final-resolution",
              "adr-0013",
              "adr-0014"
            ]
          },
          "constraint": {
            "expression": "Configuration owns immutable requirement definitions and their version history; Evidence owns deterministic interpretation/evaluation of those definitions and their eligible support.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "evidence_sufficiency_requirement"
        },
        {
          "assertion_id": "requirement.evaluator",
          "authority": {
            "source_ids": [
              "decision-364-final-resolution",
              "adr-0014",
              "decision-417-proposal"
            ]
          },
          "constraint": {
            "expression": "A sufficiency requirement uses the executable MinimumEligibleEvidence(minimum_distinct_observations, qualifying_roles) predicate, not free-text meaning, caller-selected contributing bindings, or caller-authored dispositions. Evidence deterministically evaluates the complete eligible binding universe. Satisfaction and every lower or upper disposition bound count distinct EvidenceObservationId values: multiple eligible binding roots referencing one observation count once. Immutable proof preserves the counted observation identities and every qualifying contributor or deficiency-witness binding root with its interpreted EvidenceFactRef support.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "evidence_sufficiency_requirement"
        },
        {
          "assertion_id": "requirement.negative-witness",
          "authority": {
            "source_ids": [
              "decision-364-final-resolution",
              "adr-0014"
            ]
          },
          "constraint": {
            "expression": "NOT_APPLICABLE requires an authoritative Configuration-issued negative-applicability witness; missing, zero, stale, or unavailable bindings do not by themselves establish non-applicability.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "evidence_sufficiency_requirement"
        },
        {
          "assertion_id": "basis.complete",
          "authority": {
            "source_ids": [
              "decision-364-final-resolution",
              "adr-0013",
              "adr-0015",
              "adr-0016"
            ]
          },
          "constraint": {
            "expression": "CurrentEvidenceBasis protects the exact BasisScopeKey and the complete positive and negative dependency universe: Evidence support, typed target-owner revisions, claim-catalog versions, requirement versions, typed canonical-context versions, and selected-or-absent guards. A global epoch, untyped hash, timestamp, or partial owner view is not a substitute for complete typed dependencies and reconstructable history.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "current_evidence_basis"
        },
        {
          "assertion_id": "basis.stale-vocabulary",
          "authority": {
            "source_ids": [
              "decision-364-final-resolution",
              "adr-0013",
              "adr-0016"
            ]
          },
          "constraint": {
            "closure": "closed",
            "members": [
              "CLAIM_CHANGED",
              "DECISION_CHANGED",
              "EVIDENCE_SUPPORT_CHANGED",
              "NEGATIVE_PREDICATE_BROKEN",
              "REQUIREMENTS_CHANGED",
              "SUPPORT_CHANGED_BY_TIME",
              "TARGET_CHANGED"
            ],
            "name": "category"
          },
          "kind": "vocabulary",
          "subject": "stale_evidence_basis"
        },
        {
          "assertion_id": "basis.temporal-meaning",
          "authority": {
            "source_ids": [
              "decision-364-final-resolution",
              "adr-0015",
              "adr-0016"
            ]
          },
          "constraint": {
            "expression": "At exact read and fresh trusted T=K revalidation, each materially used owner whose as-of meaning may change without a version advance attests complete typed meaning and verifiable temporal cause bound to exact identity/version/basis/read boundary/provenance and complete effective/recorded and correction ancestry, including applicable selection/absence history. Lawful governing Decision drift maps to DECISION_CHANGED; target-root drift to TARGET_CHANGED; claim drift to CLAIM_CHANGED; requirement drift to REQUIREMENTS_CHANGED; positive canonical-context or Evidence-support drift to EVIDENCE_SUPPORT_CHANGED with exact typed changed references; broken negative guards to NEGATIVE_PREDICATE_BROKEN; independent time-only fitness drift to SUPPORT_CHANGED_BY_TIME. Missing or incomplete meaning yields a distinct no-basis outcome; unexplained or contradictory same-version meaning is INVALID_HISTORY. Application never infers cause from elapsed time or a difference between two views; no synthetic clock version or eighth stale category is introduced.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "current_evidence_basis"
        },
        {
          "assertion_id": "basis.atomic-commit",
          "authority": {
            "source_ids": [
              "decision-364-final-resolution",
              "adr-0013",
              "adr-0015",
              "adr-0016"
            ]
          },
          "constraint": {
            "expression": "A dependent write performs fresh trusted T=K reconstruction of the complete owner/Evidence universe and atomically validates prior/fresh typed witnesses against authoritative history. Return all independently applicable stale categories with exact typed changed references and broken guards. Stale or no-basis outcomes commit no dependent judgment and require a fresh read; never silently substitute newer support.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "current_evidence_basis"
        }
      ],
      "contract_id": "evidence.r3-current-basis",
      "display": {
        "summary": "Durable judgment-relative Evidence, typed sufficiency, and complete current-basis semantics.",
        "title": "R3 Evidence and Current Basis"
      },
      "operation": "revise",
      "owner": "evidence",
      "revision": 2,
      "scope": {
        "release": [
          "R3"
        ]
      },
      "supersedes_revision": 1
    }
  ],
