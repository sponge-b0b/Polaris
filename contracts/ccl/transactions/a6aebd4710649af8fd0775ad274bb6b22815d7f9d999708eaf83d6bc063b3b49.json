  "proposal_hash": "sha256:a6aebd4710649af8fd0775ad274bb6b22815d7f9d999708eaf83d6bc063b3b49",
  "revisions": [
    {
      "assertions": [
        {
          "assertion_id": "facts.domain-owned",
          "authority": {
            "source_ids": [
              "decision-355-resolution",
              "adr-0011",
              "adr-0012"
            ]
          },
          "constraint": {
            "expression": "R3 persists durable business facts directly under their owning domain semantics and composes Durable Decision Memory through Application queries. No monolithic DecisionRecord, generic event store, workflow archive, report-owned model, generic Claim graph, or generic Evidence graph is canonical business truth. Material history is append-only, cross-domain references are typed, transaction boundaries are atomic only where partial commit would make the business statement false or unreconstructable, and long-running external/model work remains outside store transactions. Current/historical reconstruction preserves what was known then separately from what is known now.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "r3_durable_decision_memory"
        },
        {
          "assertion_id": "facts.external-authority",
          "authority": {
            "source_ids": [
              "decision-350-resolution",
              "decision-351-resolution",
              "adr-0006",
              "adr-0007",
              "adr-0011"
            ]
          },
          "constraint": {
            "expression": "External specialist systems retain factual authority; Polaris owns its observation, evidentiary use, interpretation, and derived decision meaning. Prompts, provider drafts and retries, hidden reasoning traces, debate topology, and workflow identities remain technical process detail, not canonical business judgment or business identity.",
            "modality": "required"
          },
          "kind": "invariant",
          "subject": "r3_business_fact_authority"
        }
      ],
      "contract_id": "platform.r3-domain-owned-facts",
      "display": {
        "summary": "Canonical business truth remains domain-owned and distinct from workflow, report, provider, and external factual authority.",
        "title": "R3 Domain-Owned Facts and Authority Boundaries"
      },
      "operation": "create",
      "owner": "platform",
      "revision": 1,
      "scope": {
        "release": [
          "R3"
        ]
      },
      "supersedes_revision": null
    }
  ],
  "schema": "polaris.ccl/v1"
